{
  "name": "lifting3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm eda:build && vp build",
    "cf-typegen": "wrangler types",
    "ci": "pnpm check",
    "check": "corepack pnpm eda:build && corepack pnpm cf-typegen && react-router typegen && vp check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lifting3 --local",
    "db:migrate:remote": "wrangler d1 migrations apply lifting3 --remote",
    "db:seed:local": "node --experimental-strip-types ./scripts/seed-d1-workouts.ts --local",
    "db:seed:remote": "node --experimental-strip-types ./scripts/seed-d1-workouts.ts --remote",
    "deploy": "pnpm build && wrangler deploy",
    "eda:build": "corepack pnpm --dir effect-durable-agent build",
    "eda:install": "corepack pnpm --dir effect-durable-agent install --frozen-lockfile",
    "dev": "vp dev",
    "fix": "corepack pnpm cf-typegen && react-router typegen && vp check --fix",
    "import:workout-json": "node --experimental-strip-types ./scripts/import-workout-json.ts",
    "preinstall": "node --experimental-strip-types ./scripts/ensure-eda-submodule.ts",
    "postinstall": "corepack pnpm eda:install && corepack pnpm eda:build && corepack pnpm cf-typegen",
    "preview": "pnpm build && vp preview",
    "test": "vp test --run && vp test --config vitest.dom.config.mjs --run",
    "test:watch": "vp test watch",
    "typecheck": "pnpm cf-typegen && react-router typegen && tsc -b",
    "validate:workout-json": "node --experimental-strip-types ./scripts/validate-workout-json.ts",
    "verify:lifting2-exercises": "node --experimental-strip-types ./scripts/verify-lifting2-exercise-compat.ts",
    "export:app-state": "node --experimental-strip-types ./scripts/export-app-state.ts",
    "import:app-state": "node --experimental-strip-types ./scripts/import-app-state.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.102",
    "effect-durable-agent": "link:./effect-durable-agent",
    "isbot": "^5.1.36",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "shadcn": "^4.2.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.5",
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@cloudflare/workers-types": "4.20260416.2",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cf": "^0.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.18",
    "vite-plus": "0.1.18",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "packageManager": "pnpm@10.33.0"
}
